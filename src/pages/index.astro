---
import StreamingHome from '../components/StreamingHome.astro';
import { defaultLocale, siteConfig } from '../config/site';
import { useTranslations } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

const locale = defaultLocale;
const t = useTranslations(locale);
---

<BaseLayout title={siteConfig.name} description={t('site.description')} locale={locale}>
  <StreamingHome locale={locale} />
</BaseLayout>
