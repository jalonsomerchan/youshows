---
import SeriesDetail from '../../../components/SeriesDetail.astro';
import { defaultLocale, locales, type Locale } from '../../../config/site';
import { catalog, type Series } from '../../../data/catalog';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return locales.filter((locale) => locale !== defaultLocale).flatMap((locale) =>
    catalog.series.map((series) => ({ params: { locale, slug: series.id }, props: { locale, series } }))
  );
}

const { locale, series } = Astro.props as { locale: Locale; series: Series };
---

<BaseLayout title={series.title} description={series.description} locale={locale}>
  <SeriesDetail series={series} locale={locale} />
</BaseLayout>
