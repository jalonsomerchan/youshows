---
import type { Locale } from '../config/site';
import {
  getAgeRatingLabel,
  getLanguageLabel,
  seriesAgeRatings,
  seriesLanguages,
} from '../config/series-metadata';
import { useTranslations } from '../i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<dialog
  class="content-settings"
  id="content-settings"
  data-content-settings
  aria-labelledby="content-settings-title"
  aria-describedby="content-settings-description"
>
  <div class="content-settings__header">
    <div>
      <span class="content-settings__eyebrow">{t('settings.eyebrow')}</span>
      <h2 id="content-settings-title">{t('settings.title')}</h2>
    </div>
    <button class="content-settings__close" type="button" data-settings-close aria-label={t('settings.close')}>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
  </div>
  <p id="content-settings-description">{t('settings.description')}</p>

  <fieldset>
    <legend>{t('settings.languages')}</legend>
    <div class="content-settings__group-actions">
      <button type="button" data-settings-group-action="languages" data-settings-checked="true">{t('settings.selectAll')}</button>
      <button type="button" data-settings-group-action="languages" data-settings-checked="false">{t('settings.clearSelection')}</button>
    </div>
    <div class="content-settings__options">
      {seriesLanguages.map((language) => (
        <label>
          <input type="checkbox" value={language} data-preference-group="languages" />
          <span>{getLanguageLabel(language, t)}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <fieldset>
    <legend>{t('settings.ages')}</legend>
    <div class="content-settings__group-actions">
      <button type="button" data-settings-group-action="ageRatings" data-settings-checked="true">{t('settings.selectAll')}</button>
      <button type="button" data-settings-group-action="ageRatings" data-settings-checked="false">{t('settings.clearSelection')}</button>
    </div>
    <div class="content-settings__options">
      {seriesAgeRatings.map((ageRating) => (
        <label>
          <input type="checkbox" value={ageRating} data-preference-group="ageRatings" />
          <span>{getAgeRatingLabel(ageRating, undefined, t)}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="content-settings__footer">
    <p aria-live="polite" data-settings-status data-saved-label={t('settings.saved')}></p>
    <button class="button button--soft" type="button" data-settings-reset>{t('settings.reset')}</button>
    <button class="button button--primary" type="button" data-settings-close>{t('settings.done')}</button>
  </div>
</dialog>

<script>
  import '../scripts/content-settings';
</script>

<style>
  .content-settings { width: min(calc(100% - 1.5rem), 42rem); max-height: min(88svh, 50rem); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 1.25rem; overflow: auto; background: var(--color-surface); color: var(--color-text); box-shadow: var(--shadow-lg); }
  .content-settings::backdrop { background: rgb(7 9 15 / .72); backdrop-filter: blur(6px); }
  .content-settings__header { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .content-settings__eyebrow { color: var(--color-primary); font-size: .7rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .content-settings h2 { margin: .2rem 0 0; font-size: clamp(1.55rem, 6vw, 2.15rem); letter-spacing: -.045em; line-height: 1.05; }
  .content-settings > p { max-width: 55ch; margin: .75rem 0 1.35rem; color: var(--color-text-muted); }
  .content-settings__close { display: grid; flex: 0 0 2.65rem; width: 2.65rem; height: 2.65rem; place-items: center; border: 1px solid var(--color-border); border-radius: 50%; background: var(--color-surface-soft); color: var(--color-text); cursor: pointer; }
  .content-settings__close svg { width: 1.2rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 2; }
  .content-settings fieldset { margin: 0; border: 0; border-top: 1px solid var(--color-border); padding: 1.25rem 0; }
  .content-settings legend { float: left; margin: 0; padding: 0; font-size: 1.05rem; font-weight: 800; }
  .content-settings__group-actions { display: flex; justify-content: end; gap: .8rem; margin-bottom: .85rem; }
  .content-settings__group-actions button { border: 0; padding: .2rem 0; background: transparent; color: var(--color-primary); font-size: .75rem; font-weight: 750; cursor: pointer; }
  .content-settings__options { display: grid; clear: both; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; }
  .content-settings__options label { display: flex; min-height: 2.8rem; align-items: center; gap: .65rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: .65rem .75rem; background: var(--color-surface-soft); color: var(--color-text-muted); font-size: .84rem; font-weight: 650; cursor: pointer; }
  .content-settings__options label:has(input:checked) { border-color: color-mix(in srgb, var(--color-primary), var(--color-border) 55%); background: var(--color-primary-soft); color: var(--color-text); }
  .content-settings__options input { width: 1.1rem; height: 1.1rem; margin: 0; accent-color: var(--color-primary); }
  .content-settings__footer { position: sticky; bottom: -1.25rem; display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: .55rem; margin: 0 -1.25rem -1.25rem; border-top: 1px solid var(--color-border); padding: .85rem 1.25rem calc(.85rem + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--color-surface), transparent 5%); backdrop-filter: blur(12px); }
  .content-settings__footer p { margin: 0; color: var(--color-success); font-size: .75rem; font-weight: 700; }
  .content-settings__footer .button { min-height: 2.6rem; padding: .7rem .85rem; font-size: .82rem; }
  @media (min-width: 640px) { .content-settings { padding: 1.6rem; } .content-settings__options { grid-template-columns: repeat(3, minmax(0, 1fr)); } .content-settings__footer { bottom: -1.6rem; margin: 0 -1.6rem -1.6rem; padding-inline: 1.6rem; } }
</style>
