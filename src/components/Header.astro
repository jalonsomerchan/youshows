---
import { localeFlags, localeLabels, locales, siteConfig, type Locale } from '../config/site';
import { getLocalizedPath, useTranslations } from '../i18n/ui';
import { withBasePath } from '../utils/paths';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const homeUrl = getLocalizedPath('/', locale);
---

<header class="site-header">
  <nav aria-label={t('nav.main')} class="site-header__inner">
    <a class="brand" href={homeUrl} aria-label={`${siteConfig.name} · ${t('nav.home')}`}>
      <span aria-hidden="true">AK</span><strong>{siteConfig.name}</strong>
    </a>
    <div class="desktop-nav">
      <a href={homeUrl}>{t('nav.home')}</a>
      <a href={`${homeUrl}#catalog`}>{t('home.explore')}</a>
      <a href={`${homeUrl}#my-list`}>{t('nav.myList')}</a>
    </div>
    <div class="header-actions">
      <a class="icon-button" href={`${homeUrl}#search`} aria-label={t('nav.search')}>
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m16 16 4 4" /></svg>
      </a>
      <button class="icon-button theme-toggle" type="button" aria-label={t('nav.theme')} title={t('nav.theme')} data-theme-toggle>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path data-theme-icon /></svg>
      </button>
      <button class="icon-button" type="button" aria-label={t('nav.settings')} aria-haspopup="dialog" aria-controls="content-settings" data-settings-open>
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3v-.2h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z" /></svg>
      </button>
      <details class="locale-menu">
        <summary aria-label={t('nav.language')} title={t('nav.language')}>
          <img class="locale-menu__flag" src={withBasePath(localeFlags[locale])} width="28" height="19" alt="" aria-hidden="true" />
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m7 10 5 5 5-5" /></svg>
          <span class="sr-only">{t('nav.language')}: {localeLabels[locale]}</span>
        </summary>
        <div class="locale-menu__panel">
          {locales.map((menuLocale) => (
            <a
              class:list={{ 'locale-menu__option': true, 'locale-menu__option--current': menuLocale === locale }}
              href={getLocalizedPath('/', menuLocale)}
              hreflang={menuLocale}
              lang={menuLocale}
              aria-current={menuLocale === locale ? 'true' : undefined}
            >
              <img src={withBasePath(localeFlags[menuLocale])} width="28" height="19" alt="" aria-hidden="true" />
              <span>{localeLabels[menuLocale]}</span>
              {menuLocale === locale && <svg aria-label={t('nav.currentLanguage')} viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg>}
            </a>
          ))}
        </div>
      </details>
    </div>
  </nav>
</header>

<nav class="mobile-nav" aria-label={t('nav.main')}>
  <a href={homeUrl}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8v9H7v-6h10v6" /></svg><span>{t('nav.home')}</span></a>
  <a href={`${homeUrl}#search`}><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m16 16 4 4" /></svg><span>{t('nav.search')}</span></a>
  <a href={`${homeUrl}#my-list`}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg><span>{t('nav.myList')}</span></a>
  <button type="button" aria-haspopup="dialog" aria-controls="content-settings" data-settings-open><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19 12a7 7 0 0 0-.1-1l2-1.5-2-3.4-2.4 1A7 7 0 0 0 15 6l-.3-2.6h-4L10.4 6a7 7 0 0 0-1.5.9l-2.4-1-2 3.4 2 1.6a7 7 0 0 0 0 2.2l-2 1.6 2 3.4 2.4-1a7 7 0 0 0 1.5.9l.3 2.6h4L15 18a7 7 0 0 0 1.5-.9l2.4 1 2-3.4-2-1.6a7 7 0 0 0 .1-1.1Z" /></svg><span>{t('nav.settings')}</span></button>
</nav>

<script>
  const themeIcons = {
    dark: 'M20 15.4A8 8 0 0 1 8.6 4 8.3 8.3 0 1 0 20 15.4Z',
    light: 'M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
  };
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeIcon = document.querySelector<SVGPathElement>('[data-theme-icon]');

  const updateThemeIcon = (theme: keyof typeof themeIcons) => {
    themeIcon?.setAttribute('d', themeIcons[theme]);
  };

  updateThemeIcon(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');

  themeToggle?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme;
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('alon-kids.theme', next);
    updateThemeIcon(next);
  });
</script>

<style>
  .site-header { position: absolute; z-index: var(--z-header); top: 0; right: 0; left: 0; padding: .7rem 1rem; }
  .site-header__inner { display: flex; width: min(100%, 90rem); min-height: 3.25rem; align-items: center; justify-content: space-between; gap: 1rem; margin-inline: auto; border: 1px solid color-mix(in srgb, var(--color-border), transparent 35%); border-radius: var(--radius-full); padding: .35rem .45rem .35rem .75rem; background: color-mix(in srgb, var(--color-surface), transparent 22%); box-shadow: var(--shadow-sm); backdrop-filter: blur(18px) saturate(130%); }
  .brand { display: inline-flex; align-items: center; gap: .5rem; text-decoration: none; }
  .brand > span { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: .65rem; background: linear-gradient(145deg, var(--color-primary), var(--color-secondary)); color: white; font-size: .7rem; font-weight: 950; letter-spacing: -.04em; }
  .brand strong { font-size: 1rem; letter-spacing: -.035em; }
  .desktop-nav { display: none; align-items: center; gap: 1.4rem; margin-right: auto; }
  .desktop-nav a { color: var(--color-text-muted); font-size: .84rem; font-weight: 650; text-decoration: none; }
  .desktop-nav a:hover { color: var(--color-text); }
  .header-actions { display: flex; align-items: center; gap: .2rem; }
  .icon-button { display: grid; width: 2.35rem; height: 2.35rem; place-items: center; border: 0; border-radius: 50%; background: transparent; color: var(--color-text); cursor: pointer; text-decoration: none; transition: background var(--transition-base), transform var(--transition-fast); }
  .icon-button:hover { background: var(--color-surface-soft); }
  .icon-button:active { transform: scale(.94); }
  .icon-button svg { width: 1.15rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
  .locale-menu { position: relative; }
  .locale-menu summary { display: flex; width: 2.75rem; height: 2.35rem; align-items: center; justify-content: center; gap: .1rem; border-radius: var(--radius-full); cursor: pointer; list-style: none; transition: background var(--transition-base), transform var(--transition-fast); }
  .locale-menu summary::-webkit-details-marker { display: none; }
  .locale-menu summary:hover, .locale-menu[open] summary { background: var(--color-surface-soft); }
  .locale-menu summary:active { transform: scale(.94); }
  .locale-menu summary svg { width: .8rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; transition: transform var(--transition-base); }
  .locale-menu[open] summary svg { transform: rotate(180deg); }
  .locale-menu__flag, .locale-menu__option img { width: 1.35rem; height: .92rem; border-radius: .18rem; object-fit: cover; box-shadow: 0 0 0 1px rgb(15 23 42 / .2); }
  .locale-menu__panel { position: absolute; top: calc(100% + .6rem); right: 0; display: grid; min-width: 10.25rem; overflow: hidden; border: 1px solid color-mix(in srgb, var(--color-border), transparent 15%); border-radius: var(--radius-lg); padding: .3rem; background: color-mix(in srgb, var(--color-surface-raised), transparent 4%); box-shadow: var(--shadow-md); backdrop-filter: blur(18px) saturate(140%); transform-origin: top right; animation: locale-menu-in var(--transition-base) both; }
  .locale-menu__option { display: flex; min-height: 2.5rem; align-items: center; gap: .6rem; border-radius: calc(var(--radius-md) - .15rem); padding: .45rem .55rem; color: var(--color-text-muted); font-size: .82rem; font-weight: 650; text-decoration: none; }
  .locale-menu__option:hover, .locale-menu__option--current { background: var(--color-surface-soft); color: var(--color-text); }
  .locale-menu__option--current { font-weight: 780; }
  .locale-menu__option svg { width: 1rem; margin-left: auto; fill: none; stroke: var(--color-primary); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2.5; }
  @keyframes locale-menu-in { from { opacity: 0; transform: translateY(-.3rem) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
  .mobile-nav { position: fixed; z-index: var(--z-header); right: .75rem; bottom: max(.75rem, env(safe-area-inset-bottom)); left: .75rem; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: .4rem; background: color-mix(in srgb, var(--color-surface), transparent 10%); box-shadow: var(--shadow-lg); backdrop-filter: blur(18px); }
  .mobile-nav a, .mobile-nav button { display: grid; min-height: 3rem; place-items: center; align-content: center; gap: .15rem; border: 0; border-radius: var(--radius-md); padding: 0; background: transparent; color: var(--color-text-muted); font-size: .62rem; font-weight: 700; text-decoration: none; cursor: pointer; }
  .mobile-nav a:hover, .mobile-nav a:active, .mobile-nav button:hover, .mobile-nav button:active { background: var(--color-surface-soft); color: var(--color-text); }
  .mobile-nav svg { width: 1.15rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
  @media (min-width: 768px) { .site-header { padding: 1rem 2rem; } .site-header__inner { padding-inline: .55rem .65rem; } .desktop-nav { display: flex; } .mobile-nav { display: none; } }
</style>
