---
import type { Locale } from '../config/site';
import type { Series } from '../data/catalog';
import ShowCard from './ShowCard.astro';

interface Props {
  id: string;
  title: string;
  series: Series[];
  locale: Locale;
}

const { id, title, series, locale } = Astro.props;
---

{series.length > 0 && (
  <section class="content-rail" data-preference-section aria-labelledby={`${id}-title`}>
    <div class="section-heading">
      <h2 id={`${id}-title`}>{title}</h2>
    </div>
    <div class="rail">
      {series.map((item) => <ShowCard series={item} locale={locale} />)}
    </div>
  </section>
)}
