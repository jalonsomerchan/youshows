---
import type { Locale } from '../config/site';
import {
  getAgeRatingLabel,
  getLanguageLabel,
  seriesAgeRatings,
  seriesLanguages,
} from '../config/series-metadata';
import { useTranslations } from '../i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<dialog
  class="content-onboarding"
  data-content-onboarding
  data-language-required={t('onboarding.languageRequired')}
  data-age-required={t('onboarding.ageRequired')}
  data-step-languages={t('onboarding.stepLanguages')}
  data-step-ages={t('onboarding.stepAges')}
  aria-hidden="true"
  data-nosnippet
  aria-labelledby="content-onboarding-title"
  aria-describedby="content-onboarding-description"
>
  <div class="content-onboarding__header">
    <div class="content-onboarding__intro">
      <span>{t('onboarding.eyebrow')}</span>
      <h2 id="content-onboarding-title">{t('onboarding.title')}</h2>
      <p id="content-onboarding-description">{t('onboarding.description')}</p>
    </div>
    <button class="content-onboarding__close" type="button" data-onboarding-close aria-label={t('onboarding.close')}>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
  </div>

  <p class="content-onboarding__step" data-onboarding-progress>{t('onboarding.stepLanguages')}</p>

  <section class="content-onboarding__panel" data-onboarding-panel="languages" aria-labelledby="onboarding-languages-title">
    <h3 id="onboarding-languages-title">{t('onboarding.languagesTitle')}</h3>
    <div class="content-onboarding__options" role="group" aria-labelledby="onboarding-languages-title">
      {seriesLanguages.map((language) => (
        <label>
          <input type="checkbox" value={language} data-onboarding-group="languages" />
          <span>{getLanguageLabel(language, t)}</span>
        </label>
      ))}
    </div>
    <div class="content-onboarding__actions">
      <button class="button button--soft" type="button" data-onboarding-skip>{t('onboarding.skip')}</button>
      <button class="button button--primary" type="button" data-onboarding-next>{t('onboarding.next')}</button>
    </div>
  </section>

  <section class="content-onboarding__panel" data-onboarding-panel="ageRatings" aria-labelledby="onboarding-ages-title" hidden>
    <h3 id="onboarding-ages-title">{t('onboarding.agesTitle')}</h3>
    <div class="content-onboarding__options" role="group" aria-labelledby="onboarding-ages-title">
      {seriesAgeRatings.map((ageRating) => (
        <label>
          <input type="checkbox" value={ageRating} data-onboarding-group="ageRatings" />
          <span>{getAgeRatingLabel(ageRating, undefined, t)}</span>
        </label>
      ))}
    </div>
    <div class="content-onboarding__actions">
      <button class="button button--soft" type="button" data-onboarding-back>{t('onboarding.back')}</button>
      <div class="content-onboarding__complete-actions">
        <button class="content-onboarding__skip" type="button" data-onboarding-skip>{t('onboarding.skip')}</button>
        <button class="button button--primary" type="button" data-onboarding-complete>{t('onboarding.continue')}</button>
      </div>
    </div>
  </section>

  <p class="content-onboarding__error" aria-live="polite" data-onboarding-error></p>
</dialog>

<script>
  import '../scripts/content-onboarding';
</script>

<style>
  .content-onboarding { position: fixed; inset: 50% auto auto 50%; width: min(calc(100% - 1.5rem), 42rem); max-height: min(88svh, 52rem); margin: 0; border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 1.25rem; overflow: auto; transform: translate(-50%, -50%); background: var(--color-surface); color: var(--color-text); box-shadow: var(--shadow-lg); }
  .content-onboarding::backdrop { background: rgb(7 9 15 / .72); backdrop-filter: blur(6px); }
  .content-onboarding__header { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .content-onboarding__intro > span { color: var(--color-primary); font-size: .7rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  .content-onboarding h2 { margin: .2rem 0 0; font-size: clamp(1.7rem, 7vw, 2.4rem); letter-spacing: -.05em; line-height: 1.04; }
  .content-onboarding__intro p { max-width: 55ch; margin: .75rem 0 1.35rem; color: var(--color-text-muted); }
  .content-onboarding__close { display: grid; flex: 0 0 2.65rem; width: 2.65rem; height: 2.65rem; place-items: center; border: 1px solid var(--color-border); border-radius: 50%; background: var(--color-surface-soft); color: var(--color-text); cursor: pointer; }
  .content-onboarding__close svg { width: 1.2rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 2; }
  .content-onboarding__step { margin: 0 0 .75rem; color: var(--color-text-soft); font-size: .78rem; font-weight: 750; }
  .content-onboarding__panel { margin: 0; border-top: 1px solid var(--color-border); padding: 1.1rem 0 0; }
  .content-onboarding__panel h3 { margin: 0 0 .7rem; font-size: 1.05rem; font-weight: 800; }
  .content-onboarding__options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; }
  .content-onboarding__options label { display: flex; min-height: 2.8rem; align-items: center; gap: .65rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: .65rem .75rem; background: var(--color-surface-soft); color: var(--color-text-muted); font-size: .84rem; font-weight: 650; cursor: pointer; }
  .content-onboarding__options label:has(input:checked) { border-color: color-mix(in srgb, var(--color-primary), var(--color-border) 55%); background: var(--color-primary-soft); color: var(--color-text); }
  .content-onboarding__options input { width: 1.1rem; height: 1.1rem; margin: 0; accent-color: var(--color-primary); }
  .content-onboarding__actions { display: grid; grid-template-columns: 1fr 1.35fr; gap: .6rem; margin-top: 1.1rem; }
  .content-onboarding__actions .button { width: 100%; }
  .content-onboarding__complete-actions { display: grid; gap: .4rem; }
  .content-onboarding__skip { justify-self: end; border: 0; padding: 0; background: transparent; color: var(--color-primary); font: inherit; font-size: .78rem; font-weight: 750; cursor: pointer; }
  .content-onboarding__error { min-height: 1.2rem; margin: .75rem 0 0; color: var(--color-danger); font-size: .82rem; font-weight: 700; }
  @media (min-width: 640px) { .content-onboarding { padding: 1.6rem; } .content-onboarding__options { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
