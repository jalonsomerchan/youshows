---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContentOnboarding from '../components/ContentOnboarding.astro';
import ContentSettings from '../components/ContentSettings.astro';
import { defaultLocale, siteConfig, type Locale } from '../config/site';
import { useTranslations } from '../i18n/ui';
import { getAbsoluteUrl, stripBasePath, withBasePath } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale?: Locale;
  immersive?: boolean;
}

const {
  title = siteConfig.name,
  image = 'og-image.svg',
  locale = defaultLocale,
  immersive = false,
} = Astro.props;

const t = useTranslations(locale);
const description = Astro.props.description ?? t('site.description');
const pageTitle = title === siteConfig.name ? title : `${title} · ${siteConfig.name}`;
const routePath = stripBasePath(Astro.url.pathname);
const canonicalUrl = getAbsoluteUrl(withBasePath(routePath), siteConfig.url);
const imageUrl = getAbsoluteUrl(withBasePath(image), siteConfig.url);
const ogLocale = locale === 'es' ? 'es_ES' : 'en_US';
const serviceWorkerUrl = withBasePath('sw.js');
const serviceWorkerScope = withBasePath('');
const registerServiceWorker = import.meta.env.PROD;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={siteConfig.name} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.name} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBasePath('favicon.svg')} />
    <link rel="apple-touch-icon" href={withBasePath('apple-touch-icon.png')} />
    <link rel="manifest" href={withBasePath('manifest.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#0b0d14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7fb" media="(prefers-color-scheme: light)" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('alon-kids.theme') ?? localStorage.getItem('youshows.theme');
        const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = stored || preferred;
      })();
    </script>
    {registerServiceWorker && (
      <script is:inline define:vars={{ serviceWorkerUrl, serviceWorkerScope }}>
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => {
            navigator.serviceWorker.register(serviceWorkerUrl, { scope: serviceWorkerScope });
          });
        }
      </script>
    )}
  </head>
  <body class:list={{ immersive }}>
    <a class="skip-link" href="#main-content">{t('accessibility.skipContent')}</a>
    {!immersive && <Header locale={locale} />}
    {!immersive && <ContentSettings locale={locale} />}
    {!immersive && <ContentOnboarding locale={locale} />}
    <main id="main-content">
      <slot />
    </main>
    {!immersive && <Footer locale={locale} />}
  </body>
</html>
